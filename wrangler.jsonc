{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-flickr-proxy",
  "main": "src/index.ts",
  "account_id": "24b45709d060d957340180e995f0d373",
  "compatibility_date": "2025-05-01",
  "observability": {
    "enabled": true
  },
  // Smart Placement: Worker の実行 colo を subrequest の宛先 (Cloud Run
  // asia-northeast1) に近づける。2026-06-09 以降の新規 Cloud Run service の
  // run.app hostname が US 側 Google Frontend に配布されない障害下でも、
  // fetch が asia 発になれば届く (asia 経由の到達実績あり)。Refs #1
  "placement": {
    "mode": "smart"
  },
  // custom domain (`flickr-proxy.mtamaramu.com`) を生やしたので workers.dev は
  // off。custom_domain=true で wrangler が DNS record + route を自動生成する
  // (zone `mtamaramu.com` は既に CF account に存在)。
  "workers_dev": false,
  "routes": [
    { "pattern": "flickr-proxy.mtamaramu.com", "custom_domain": true }
  ],
  // secrets-inventory / HealthConnectReaderWorker と同じ **single-env 運用**
  // (staging = prod)。CI からは PR merge / tag push どちらも root config の
  // `npx wrangler deploy` を走らせる。Refs ippoan/cf-flickr-proxy#1
  //
  // secret binding は持たない。rust-flickr (staging) は --allow-unauthenticated
  // で、認証情報 (FLICKR_* / DATABASE_URL) は全て Cloud Run 側の
  // Secret Manager 参照 — Worker は素通しするだけ。
  //
  // ci-workflows の secret-verify は「宣言ゼロ」を fail にする (監査可能性の
  // ため、secret 不要な worker は空リストを明示する) — Refs PR #2 CI。
  "secrets": {
    "required": []
  },
  "vars": {
    // proxy 先 rust-flickr (Cloud Run, staging = 実運用)
    "RUST_FLICKR_URL": "https://rust-flickr-staging-747065218280.asia-northeast1.run.app",
    // CORS を許可する front origin (comma 区切り)。front の本番 origin が
    // 決まったらここに追記する。空でも proxy 自体は機能する (CORS ヘッダが
    // 付かないだけ — Cloud Scheduler / curl は CORS 無関係)。
    "ALLOWED_ORIGINS": "http://localhost:3000"
  }
}
